<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:oauth="http://www.mulesoft.org/schema/mule/oauth"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/oauth http://www.mulesoft.org/schema/mule/oauth/current/mule-oauth.xsd">

  <!--
    This file is a copyable example and is intentionally kept outside src/main/mule.
    The *.example.test hosts are reserved fake domains and cannot receive secrets.
  -->
  <http:listener-config name="oauth2-example-listener-config">
    <http:listener-connection host="0.0.0.0" port="8082" />
  </http:listener-config>

  <http:request-config name="fake-api-oauth2-request-config">
    <http:request-connection protocol="HTTPS"
                             host="api.example.test"
                             port="443">
      <http:authentication>
        <oauth:client-credentials-grant-type
            clientId="${oauth2.client.id}"
            clientSecret="${oauth2.client.secret}"
            tokenUrl="https://auth.example.test/oauth2/token"
            scopes="widgets:read" />
      </http:authentication>
    </http:request-connection>
  </http:request-config>

  <flow name="oauth2-client-credentials-request-example">
    <http:listener config-ref="oauth2-example-listener-config"
                   path="/oauth2-example"
                   allowedMethods="GET" />

    <!--
      The connector obtains and caches a token, then adds the Bearer authorization
      header. Do not manually fetch a token or construct an Authorization header.
    -->
    <http:request config-ref="fake-api-oauth2-request-config"
                  method="GET"
                  path="/v1/widgets" />
  </flow>
</mule>
