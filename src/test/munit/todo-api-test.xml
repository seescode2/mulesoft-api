<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

  <munit:config name="todo-api-test-suite" />

  <munit:test name="get-todos-returns-sondahub-response-test"
              description="GET todos returns the protected resource response unchanged">
    <munit:behavior>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="config-ref" whereValue="sondahub-http-request-config" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value='#[output application/json --- {ok: true, scope: "read"}]' mediaType="application/json" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\todos:todo-api-config" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[payload]" expected='#[{ok: true, scope: "read"}]' />
      <munit-tools:verify-call processor="http:request" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="config-ref" whereValue="sondahub-http-request-config" />
          <munit-tools:with-attribute attributeName="method" whereValue="GET" />
          <munit-tools:with-attribute attributeName="path" whereValue="/v1/utils/oauth/protected" />
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <munit:test name="get-todos-propagates-upstream-failure-test"
              description="An upstream failure is propagated to the existing API error handler"
              expectedErrorType="HTTP:CONNECTIVITY">
    <munit:behavior>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="config-ref" whereValue="sondahub-http-request-config" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:error typeId="HTTP:CONNECTIVITY" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <flow-ref name="get:\todos:todo-api-config" />
    </munit:execution>
  </munit:test>

  <munit:test name="build-error-response-test"
              description="The error response sub-flow returns the supplied error details">
    <munit:execution>
      <set-variable variableName="errorCode" value="TEST_ERROR" />
      <set-variable variableName="errorMessage" value="Test error message" />
      <flow-ref name="build-error-response" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[payload.error]" expected="#[&quot;TEST_ERROR&quot;]" />
      <munit-tools:assert-equals actual="#[payload.message]" expected="#[&quot;Test error message&quot;]" />
    </munit:validation>
  </munit:test>
</mule>
